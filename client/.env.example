# Copy this file to .env.local for local development

# ── Local Development ──
# Leave empty to use Vite's proxy (defined in vite.config.ts)
# The proxy forwards /api/* → http://localhost:4000
VITE_API_URL=

# ── Vercel Production ──
# Leave VITE_API_URL empty in Vercel too — the client and API are on the
# same domain (/api/* is handled by the serverless function).
# No separate backend URL needed!

# Copy this file to .env and fill in your values
# Railway will provide DATABASE_URL automatically when you link a PostgreSQL database

# PostgreSQL connection string (provided by Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT Secret - generate a strong random string for production
# Example: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# App port (Railway sets this automatically)
PORT=4000

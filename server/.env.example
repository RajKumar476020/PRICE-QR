# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values for local dev
# In Vercel, set these as Environment Variables in the dashboard
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local dev: use your local postgres or keep the sqlite for dev
# Vercel: this is auto-filled when you create a "Vercel Postgres" store
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JWT Secret — generate a strong random string:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Vercel Blob Storage token
# Vercel: this is auto-filled when you create a "Vercel Blob" store
# Local dev: leave empty to use local disk fallback
BLOB_READ_WRITE_TOKEN=""

# App port (Vercel ignores this; used locally only)
PORT=4000

# Node environment
NODE_ENV=development
